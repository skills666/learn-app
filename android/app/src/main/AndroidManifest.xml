<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false：本应用把 Gitee Token / AI Key 与全部题库存在 WebView 的
         localStorage / IndexedDB 里，开启备份等于把它们交给系统云备份与 adb backup。
         数据迁移走应用内的导出/导入 + Gitee 云同步，不依赖系统备份。 -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- screenOrientation=portrait：与 PWA 清单的 orientation: portrait 对齐。
             Web 层的移动端规则全在 max-width:768px 里，横屏手机宽度会超过 768 直接落到桌面断点
             （顶栏、统计条、卡片密度都会变成宽屏样式）。要放开横屏时，先补一套按高度/短边判断的
             移动端规则，再删掉这一行。 -->
        <!-- windowSoftInputMode=adjustResize：键盘弹起时让窗口（进而 WebView）变矮。
             Capacitor 的模板里默认就有这一行，本项目在最初的工程生成中漏掉了 —— 后果是在
             Android 15 以下（尚未强制 edge-to-edge 的机型）键盘会直接盖住页面底部的输入框。
             Android 15+ 强制 edge-to-edge 后系统不再响应 adjustResize（decorFitsSystemWindows=false），
             键盘高度改由 @capacitor-community/safe-area 在 decorView 上补 padding 让出（效果等同缩窗），
             Web 层按 visualViewport 算出的 kb 变量（见 index.html 的 bindKeyboardInset）继续兜底：
             三者在各自机型上互补，都不会重复让位。
             （注意：XML 注释里不能出现连续两个减号，上面的变量名因此不写全称） -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
