<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- 这里是"应用运行期"的窗口背景（原先写 @null）：
             1) 首帧之前窗口不定色会闪一下（深色应用上尤其明显）。填成与启动图/WebView 同色，
                启动图 → 空窗 → 页面首帧三段连起来是同一个底色，看不出接缝；
             2) edge-to-edge 后 WebView 铺满整屏（见 MainActivity 的 EdgeToEdge.enable），这块底色
                理论上露不出来，只在首帧前可见 —— 所以"跟页面主题的实时同步"由 Web 侧负责，
                这里保持启动期的深色即可。 -->
        <item name="android:background">@color/colorPrimaryDark</item>
        <!-- 状态栏/导航栏图标只用浅色是"启动期默认"：启动图与首帧前的底色恒为深色 #0D0E17，
             此时深色图标会看不见。运行期由 Web 侧 SafeArea.setSystemBarsStyle 按"应用主题"
             （而非系统深浅）动态接管，见 index.html 的 applyTheme。 -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- 三键导航栏同理（API 27+ 才认这个属性，低版本自动忽略该条） -->
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- 启动背景改为 layer-list（纯色底 + 位图按原始比例居中）：直接放位图会被拉伸铺满窗口，
             960×1600 的启动图在 20:9 长屏上会把中间的图标纵向拉长约 30%。详见 drawable/splash_launch.xml -->
        <item name="android:background">@drawable/splash_launch</item>
        <!-- Android 12+ 的启动画面只认 windowSplashScreenBackground，不设就会用库默认的白底：
             App 是深色主题，白底一闪再进星空入场非常刺眼，这里对齐启动图底色 -->
        <item name="windowSplashScreenBackground">@color/splashBg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
