<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- 这里是“应用运行期”的窗口背景：
             1) 首帧之前窗口不定色会闪一下；以前写死近黑 #0D0E17，于是浅底主题（绢 / 云海）
                每次打开手机应用都先喷一屏黑 —— 那一屏在任何网页代码之前，网页侧追不上，
                只能改这里：底色现在是 @color/startupWindowBg，跟系统深浅走（值在 values/ 与 values-night/）；
             2) edge-to-edge 后 WebView 铺满整屏（见 MainActivity 的 EdgeToEdge.enable），这块底色
                理论上露不出来，只在首帧前可见 —— 运行期主题的实时同步仍由 Web 侧负责。 -->
        <item name="android:background">@color/startupWindowBg</item>
        <!-- 系统栏图标明暗：启动期底色现在是“跟系统深浅”而不是“恒为深色”，所以这里也得跟着走；
             资源引用对 android:window* 属性成立（bool 同样在两套 values 里成对定义）。
             运行期仍由 Web 侧 SafeArea.setSystemBarsStyle 按“应用主题”接管（见 index.html 的 applyTheme）。 -->
        <item name="android:windowLightStatusBar">@bool/startupLightBars</item>
        <!-- 三键导航栏同理（API 27+ 才认这个属性，低版本自动忽略该条） -->
        <item name="android:windowLightNavigationBar">@bool/startupLightBars</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- 启动背景改为 layer-list（纯色底 + 位图按原始比例居中）：直接放位图会被拉伸铺满窗口，
             960×1600 的启动图在 20:9 长屏上会把中间的图标纵向拉长约 30%。详见 drawable/splash_launch.xml -->
        <item name="android:background">@drawable/splash_launch</item>
        <!-- Android 12+ 的启动画面只认 windowSplashScreenBackground，不设就会用库默认的白底：
             App 是深色主题，白底一闪再进页面首帧非常刺眼，所以这里也对齐 startupWindowBg（跟系统深浅，
             不再是写死的近黑）；页内已无启动遮罩，首帧底色由 index.html 开头的 bootTheme 快照提前定好 -->
        <item name="windowSplashScreenBackground">@color/startupWindowBg</item>
        <item name="android:windowLightStatusBar">@bool/startupLightBars</item>
    </style>
</resources>
