<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- 这里是"应用运行期"的窗口背景（原先写 @null）：
             1) Android 15+ 强制 edge-to-edge 后，Capacitor 按 android.adjustMarginsForEdgeToEdge=auto
                给 WebView 让出状态栏/导航栏区域，让出来的那两条露出的就是这块窗口背景 —— 填品牌底色才不突兀；
             2) @null 时首帧之前窗口不定色，容易闪一下（深色应用上尤其明显）。填成与启动图/WebView 同色，
                启动图 → 空窗 → 页面首帧三段连起来是同一个底色，看不出接缝。 -->
        <item name="android:background">@color/colorPrimaryDark</item>
        <!-- 状态栏图标恒用浅色：窗口与状态栏底色恒为深色 #0D0E17（不随应用内主题变化），
             深色图标会看不见。DayNight 只跟系统深浅走，跟应用自己的主题无关，所以只能"定死浅色" -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- 三键导航栏同理（API 27+ 才认这个属性，低版本自动忽略该条） -->
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- 启动背景改为 layer-list（纯色底 + 位图按原始比例居中）：直接放位图会被拉伸铺满窗口，
             960×1600 的启动图在 20:9 长屏上会把中间的图标纵向拉长约 30%。详见 drawable/splash_launch.xml -->
        <item name="android:background">@drawable/splash_launch</item>
        <!-- Android 12+ 的启动画面只认 windowSplashScreenBackground，不设就会用库默认的白底：
             App 是深色主题，白底一闪再进星空入场非常刺眼，这里对齐启动图底色 -->
        <item name="windowSplashScreenBackground">@color/splashBg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
