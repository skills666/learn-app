{
  "name": "learn-app",
  "version": "1.0.0",
  "description": "万法归元 - 本地·离线·私有·FSRS 间隔重复闪卡记忆",
  "private": true,
  "scripts": {
    "sync:www": "node sync-www.js",
    "check": "node scripts/check-syntax.js && node scripts/check-globals.js",
    "test": "node scripts/smoke-test.js && node scripts/render-smoke.js",
    "verify": "npm run check && npm test",
    "cap:add:android": "cap add android",
    "cap:sync": "node sync-www.js && cap sync android",
    "cap:open": "cap open android",
    "build:android": "node sync-www.js && cap sync android && node scripts/build-android.js assembleDebug"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor-community/safe-area": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
